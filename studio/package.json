{
  "name": "vertex-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node run-with-env.mjs dev",
    "start": "node run-with-env.mjs start",
    "build": "node run-with-env.mjs build",
    "deploy": "node run-with-env.mjs deploy",
    "typegen": "node run-with-env.mjs schemas extract --enforce-required-fields --path ./schema.json && node run-with-env.mjs typegen generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sanity/icons": "^3.8.0",
    "@sanity/vision": "^5.31.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^5.31.2",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5"
  }
}
